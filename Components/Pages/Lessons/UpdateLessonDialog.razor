@using EnglishLessonsWasm.Lessons.DTO
@using EnglishLessonsWasm.Lessons.Update
@using EnglishLessonsWasm.Lessons.Models
@inject IMediator mediator

<MudDialog>
    <TitleContent>
        Update Lesson @Lesson.Number
    </TitleContent>

    <DialogContent>
        <MudForm Model="UpdateLessonCommand" @ref="Form" Validation="Validator.ValidateValue" ValidationDelay="0">
            <MudNumericField @bind-Value="UpdateLessonCommand.Number"
                             For="() => UpdateLessonCommand.Number"
                             Immediate="true"
                             Label="Lesson Number"
                             Min="1" />
        </MudForm>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton OnClick="Submit" ButtonType="ButtonType.Submit" Color="Color.Primary">Send</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; }

    private MudForm Form;

    [Parameter]
    public LessonDTO Lesson { get; set; } = null!;

    private UpdateLessonCommandValidator Validator = new();

    private UpdateLessonCommand UpdateLessonCommand { get; set; } = new UpdateLessonCommand();

    protected override void OnInitialized()
    {
        UpdateLessonCommand.Id = Lesson.Id;
        UpdateLessonCommand.Number = Lesson.Number;
        UpdateLessonCommand.Verbs = Lesson.Verbs;
        UpdateLessonCommand.Words = Lesson.Words;
        UpdateLessonCommand.Expressions = Lesson.Expressions;
    }

    private async Task Submit()
    {
        await Form.ValidateAsync();

        if (Form.IsValid)
        {
            await mediator.Send(UpdateLessonCommand);
            MudDialog.Close(DialogResult.Ok(true));
        }
    }

    private void Cancel() => MudDialog.Cancel();
}
